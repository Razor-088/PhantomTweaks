# === PhantomTweaks License Server ===
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Server
PORT=3000
NODE_ENV=production

# PostgreSQL (from Supabase)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# JWT secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
LICENSE_SERVER_SECRET=
JWT_SECRET=

# Admin credentials (used for admin panel login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SellAuth (configured in SellAuth dashboard)
SELLAUTH_API_KEY=
SELLAUTH_SHOP_ID=
SELLAUTH_WEBHOOK_SECRET=

# PhantomTweaks client config
LICENSE_SERVER_URL=https://your-app.onrender.com
OFFLINE_GRACE_DAYS=7
TOKEN_EXPIRY_HOURS=24

# Store URL shown to users
STORE_URL=https://phantontweaks.sellauth.com

# SellAuth Product ID → License Type mapping
# Format: "productID:type,productID:type"
# Example: "12345:lifetime,67890:30d"
# Get Product IDs from your SellAuth dashboard > Products
SELLAUTH_PRODUCT_MAP=
