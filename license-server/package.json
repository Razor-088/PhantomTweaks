{
  "name": "phantontweaks-license-server",
  "version": "1.0.0",
  "private": true,
  "description": "PhantomTweaks License Validation Server",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
